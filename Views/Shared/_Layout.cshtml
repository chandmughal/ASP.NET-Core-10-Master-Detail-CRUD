<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - Student Marks</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><header><a asp-controller="Students" asp-action="Index">Student Marks - Master Detail CRUD</a></header>
<main class="container">@RenderBody()</main>
@await RenderSectionAsync("Scripts", required: false)
<script>
function reindexRows() {
 document.querySelectorAll("#marksBody tr").forEach((row, i) => {
  row.querySelectorAll("input").forEach(input => {
   input.name = input.name.replace(/Marks\[\d+\]/, "Marks[" + i + "]");
   input.id = input.id.replace(/Marks_\d+__/, "Marks_" + i + "__");
  });
 });
}
function addRow() {
 const i = document.querySelectorAll("#marksBody tr").length;
 const row = document.createElement("tr");
 row.innerHTML = '<td><input type="hidden" name="Marks[' + i + '].Id" value="0"><input name="Marks[' + i + '].Exam"></td>' +
 '<td><input name="Marks[' + i + '].MarksObtained" type="number" min="0" max="100" step="0.01" value="0"></td>' +
 '<td><button type="button" class="secondary" onclick="removeRow(this)">Remove</button></td>';
 document.getElementById("marksBody").appendChild(row);
}
function removeRow(button) { button.closest("tr").remove(); reindexRows(); }
</script>
</body></html>