@model StudentViewModel
<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post">
<input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="field"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="validation"></span></div>
<div class="field"><label asp-for="Gender"></label><select asp-for="Gender"><option value="">-- Select gender --</option><option>Male</option><option>Female</option><option>Other</option></select><span asp-validation-for="Gender" class="validation"></span></div>
<h2>Marks detail</h2>
<table><thead><tr><th>Exam</th><th>Marks (0-100)</th><th></th></tr></thead><tbody id="marksBody">
@for (var i = 0; i < Model.Marks.Count; i++) {
<tr><td><input asp-for="Marks[i].Id" type="hidden" /><input asp-for="Marks[i].Exam" /><span asp-validation-for="Marks[i].Exam" class="validation"></span></td>
<td><input asp-for="Marks[i].MarksObtained" type="number" min="0" max="100" step="0.01" /><span asp-validation-for="Marks[i].MarksObtained" class="validation"></span></td>
<td><button type="button" class="secondary" onclick="removeRow(this)">Remove</button></td></tr>
}
</tbody></table>
<div class="actions"><button type="button" class="secondary" onclick="addRow()">Add exam</button><button type="submit">Save</button><a asp-action="Index">Cancel</a></div>
</form>